# Puerto donde escucha el servidor
PORT=8080

# Entorno de ejecucion: development | production
NODE_ENV=development

# Cadena de conexion a MongoDB
MONGO_URL=

# Clave secreta para firmar los JWT
JWT_SECRET=

# Tiempo de expiracion del token (ej: 1h, 30m, 7d)
JWT_EXPIRES_IN=1h

# --- Mailtrap (SMTP de prueba) ---
# Host SMTP del inbox de Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io

# Puerto SMTP (2525, 587 o 25)
MAIL_PORT=2525

# Usuario SMTP del inbox
MAIL_USER=

# Contraseña SMTP del inbox
MAIL_PASS=

# Remitente que figura en los mails
MAIL_FROM=DevConf <no-reply@devconf.test>