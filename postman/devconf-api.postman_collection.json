            "url": {
              "raw": "{{baseUrl}}/api/sessions/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Asistente\",\n  \"email\": \"user1@test.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
