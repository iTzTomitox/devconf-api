          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 la primera vez, 409 si el usuario ya existe de una corrida anterior.",
                  "pm.test('Usuario disponible (201 creado o 409 ya existia)', () => {",
